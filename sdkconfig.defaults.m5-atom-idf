# **La configuració de l'ATOM en el build d'ESP-IDF** (0.190.168, l'amo: *«pots portar l'atom?»*): el mateix xip que la M5 Paper —un
# ESP32 de tota la vida— i una placa molt més petita: 4 MB de flaix, **327 KB de RAM i cap PSRAM**. O sigui que aquest fitxer és el del
# Paper sense la memòria extra i amb el que aquí no es pot pagar: sense canaris del heap i sense TLS a la PSRAM (docs/50, docs/80).

# 4 MB de flaix, en DIO com el llegeix el fabricant
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# **Cap PSRAM**: aquest xip no en té, i demanar-la seria un build que no arrenca
CONFIG_ESP32_SPIRAM_SUPPORT=

# La consola per la UART0, que és el pont USB de la placa
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
# **Els avisos de la IDF i no les seves traces**, que el port d'aquesta placa és el del prompt del sistema
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# **I la IDF sense color**, com el T5S3 des de la 0.190.91 (0.190.172, l'amo: *«Es pot treure l'ANSI?»*): `LOG_COLORS` és l'únic símbol que
# encén els codis d'escapament de les seves línies (`I (13) boot: …`, els avisos del bootloader). El color del **nostre** registre és una
# altra cosa i es tria amb `cfg.ansi` (docs/30, docs/85).
# CONFIG_LOG_COLORS is not set

# El rellotge a 240 MHz, que és el que el governador del sistema mou després per la seva porta
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# **La velocitat la governa el PM del xip** (0.190.175, l'amo: *«la cpu es pot escalar sola a esp_idf... activa la opció i adapta el
# que tenim fet manualment d'scaling»*): `esp_pm` mou el rellotge de la CPU, l'APB i el tick alhora, i els drivers de SPI, I2C, I2S i
# SDMMC agafen el seu lock d'APB durant la transacció, o sigui que el vidre i la targeta no noten el canvi (docs/50, docs/60).
CONFIG_PM_ENABLE=y
# **I el light sleep automàtic no s'encén**: el tickless idle faria becaines entre esdeveniments amb la seva idea de quietud, que és
# exactament el que `kernel::power` ja decideix (el dit, la pàgina al vidre, els deu segons del port i els vint del son més curt).
# **I el DFS no arrenca sol tampoc**: qui el configura és `power::boot` amb el rang que la persona ha permès, i un boot amb l'escala
# apagada ha de poder deixar la placa a un sol pas (docs/50, docs/60).
# CONFIG_PM_DFS_INIT_AUTO is not set
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# El torn del nucli compta mil·lisegons, i la pila del nucli és la dels 16 KB de l'Arduino (docs/75)
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# I el C++ sense excepcions ni RTTI, com al build d'Arduino
CONFIG_COMPILER_CXX_EXCEPTIONS=
CONFIG_COMPILER_CXX_RTTI=

# **Els noms llargs de la targeta encesos** (el mateix que el `sdkconfig.defaults` del projecte)
# **`FATFS_LONG_FILENAMES` no és un booleà**: a la Kconfig és el nom de l'*elecció* —els tres membres són `LFN_NONE`,
# `LFN_HEAP` i `LFN_STACK`—, o sigui que no existeix cap línia `CONFIG_FATFS_LONG_FILENAMES=y` enlloc: la línia de sota
# **és** el seu «sí», amb la memòria del nom a la pila i no al heap (docs/70).
CONFIG_FATFS_LFN_STACK=y

# La taula de particions és la de l'entorn d'Arduino d'aquesta placa
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# **La WiFi fora de la IRAM**: en un xip sense PSRAM i amb aquest build a sobre, el lloc de les instruccions és el que més falta fa
CONFIG_ESP32_WIFI_IRAM_OPT=n
CONFIG_ESP32_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=2

# **El Bluetooth, i només el BLE** (0.190.179): el teclat que aquesta placa pot fer servir és BLE, o sigui que el
# controlador s'inicialitza en mode BLE-only i la meitat Classic ni es reserva (`esp_bt_controller_mem_release`).
# **I amb NimBLE i no amb Bluedroid**: la pila del fabricant costa 684 KB de flash i ~50-70 KB de heap (mesurat el
# 31/10, docs/75), que en aquest xip sense PSRAM no hi són; NimBLE és el host petit i el perfil HID s'escriu a mà
# perquè `esp_hid` només té transport per a Bluedroid en aquesta IDF (docs/50, docs/75).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# **Els vincles s'han de desar** (0.190.197): without this the bond store lives in RAM, o sigui que el teclat d'un mòbil s'havia de
# tornar a aparellar a cada reinici i el `bt host reconnect` no podia trobar mai res —una funció que no pot funcionar és pitjor que no
# tenir-la—. Amb la persistència, els vincles van a la partició NVS que el sistema ja té per als ajustos, i el que es va aparellar una
# vegada segueix aparellat després d'apagar (docs/50, docs/70).
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# **El node de Bluetooth Mesh, també en aquesta placa** (0.190.213, l'amo: *«vaig a posarlo al atom lite»*): la pila d'Espressif damunt de la
# mateixa NimBLE del teclat, amb un element i el servidor de configuració, i res més. **Aquí és on es mira la RAM**: aquest xip no té PSRAM i
# el heap lliure és el que decideix si el teclat, el Wi-Fi i el mesh hi caben alhora —o sigui que el número que compta és `mem` amb el node
# apagat i amb `mesh on` (docs/50, docs/75). La imatge creix uns 206 KB i la ranura de 2,5 MB els té (docs/75).
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PB_ADV=y
CONFIG_BLE_MESH_PB_GATT=y
CONFIG_BLE_MESH_GATT_PROXY_SERVER=y
# **El node recorda la xarxa** on l'han posat: sense això, cada arrencada torna a ser un node verge i el provisionador l'ha de tornar a afegir.
CONFIG_BLE_MESH_SETTINGS=y
# **I l'anunci normal al costat del mesh**: és el que fa possible que el teclat i el node convisquin (docs/50).
CONFIG_BLE_MESH_SUPPORT_BLE_ADV=y
