# **La configuració del DevKit en el build d'ESP-IDF** (0.190.170): l'ESP32 pelat que aquest projecte fa servir de mínim —4 MB de flaix,
# 327 KB de RAM i **cap PSRAM**—, o sigui que la seva configuració és la de l'ATOM: el que aquí no es pot pagar és el que demana memòria
# (docs/50, docs/80).

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# **Cap PSRAM**: aquest xip no en té, i demanar-la seria un build que no arrenca
CONFIG_ESP32_SPIRAM_SUPPORT=

# La consola per la UART0, que és el pont USB de la placa
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
# **Els avisos de la IDF i no les seves traces**, que el port d'aquesta placa és el del prompt del sistema
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# **I la IDF sense color**, com el T5S3 des de la 0.190.91 (0.190.172, l'amo: *«Es pot treure l'ANSI?»*): `LOG_COLORS` és l'únic símbol que
# encén els codis d'escapament de les seves línies (`I (13) boot: …`, els avisos del bootloader). El color del **nostre** registre és una
# altra cosa i es tria amb `cfg.ansi` (docs/30, docs/85).
# CONFIG_LOG_COLORS is not set

# El rellotge a 240 MHz, que és el que el governador del sistema mou després per la seva porta
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# **La velocitat la governa el PM del xip** (0.190.175, l'amo: *«la cpu es pot escalar sola a esp_idf... activa la opció i adapta el
# que tenim fet manualment d'scaling»*): `esp_pm` mou el rellotge de la CPU, l'APB i el tick alhora, i els drivers de SPI, I2C, I2S i
# SDMMC agafen el seu lock d'APB durant la transacció, o sigui que el vidre i la targeta no noten el canvi (docs/50, docs/60).
CONFIG_PM_ENABLE=y
# **I el light sleep automàtic no s'encén**: el tickless idle faria becaines entre esdeveniments amb la seva idea de quietud, que és
# exactament el que `kernel::power` ja decideix (el dit, la pàgina al vidre, els deu segons del port i els vint del son més curt).
# **I el DFS no arrenca sol tampoc**: qui el configura és `power::boot` amb el rang que la persona ha permès, i un boot amb l'escala
# apagada ha de poder deixar la placa a un sol pas (docs/50, docs/60).
# CONFIG_PM_DFS_INIT_AUTO is not set
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# El torn del nucli compta mil·lisegons, i la pila del nucli és la dels 16 KB de l'Arduino (docs/75)
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# I el C++ sense excepcions ni RTTI, com al build d'Arduino
CONFIG_COMPILER_CXX_EXCEPTIONS=
CONFIG_COMPILER_CXX_RTTI=

# **Els noms llargs de la targeta encesos** (el mateix que el `sdkconfig.defaults` del projecte)
CONFIG_FATFS_LFN_STACK=y

# La taula de particions és la de l'entorn d'Arduino d'aquesta placa
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# **La WiFi fora de la IRAM**: en un xip sense PSRAM i amb aquest build a sobre, el lloc de les instruccions és el que més falta fa
CONFIG_ESP32_WIFI_IRAM_OPT=n
CONFIG_ESP32_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=2
