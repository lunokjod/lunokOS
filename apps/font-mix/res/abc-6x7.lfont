; A face with three letters and nothing else: A, B and C. The rest of the codes are gaps, which is what
; `run font-mix` draws on purpose — a partial face has to leave a hole and not shift the line.
lunok-font 1
width 6
height 7
gap 1
char 65
.###..
#...#.
#...#.
#####.
#...#.
#...#.
#...#.
char 66
####..
#...#.
#...#.
####..
#...#.
#...#.
####..
char 67
.####.
#....#
#.....
#.....
#.....
#....#
.####.
