{
  "build": {
    "arduino": {
      "ldscript": "esp32_out.ld",
      "memory_type": "qio_qspi"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32_DEV",
      "-DBOARD_HAS_PSRAM",
      "-mfix-esp32-psram-cache-issue",
      "-mfix-esp32-psram-cache-strategy=memw"
    ],
    "f_cpu": "240000000L",
    "f_flash": "40000000L",
    "flash_mode": "qio",
    "mcu": "esp32",
    "psram_type": "qspi",
    "variant": "esp32"
  },
  "connectivity": [
    "wifi",
    "bluetooth"
  ],
  "debug": {
    "openocd_board": "esp32-wrover.cfg"
  },
  "frameworks": [
    "arduino"
  ],
  "name": "LilyGO TTGO T-Koala",
  "upload": {
    "flash_size": "4MB",
    "maximum_ram_size": 327680,
    "maximum_size": 4194304,
    "require_upload_port": true,
    "speed": 460800
  },
  "url": "https://github.com/LilyGO/T-Koala",
  "vendor": "LilyGO"
}
