# **La configuració del Paper en el build d'ESP-IDF** (0.190.166): el `sdkconfig.defaults` del projecte és el de l'ESP32-S3 —la línia de
# memòria cau, la PSRAM octal i la consola pel USB del xip— i aquí el xip és un ESP32 de tota la vida amb PSRAM quàdruple i la consola a la
# UART0. Aquest fitxer és el mateix conjunt de decisions per a aquesta placa, i es passa amb `SDKCONFIG_DEFAULTS` perquè els dos entorns
# d'IDF no es trepitgin. **Es diu `.defaults.` i no `.` a propòsit**: el que la IDF escriu —i el que el repositori guarda com el del
# T5S3— és `sdkconfig.<entorn>`, i un fitxer amb el mateix nom seria el que es llegeix i el que s'escriu alhora (docs/50, docs/80).

# 16 MB de flaix, i el flaix com el llegeix el fabricant en aquesta placa (el mateix que diu `boards/m5stack-paper.json`)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# **La PSRAM del Paper: quàdruple i a 80 MHz** (els 8 MB que fan que aquesta placa pugui portar tots els llibres i totes les apps). El nom
# del símbol és el de l'ESP32 i no el de l'S3.
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_ESP32_SPIRAM_SPEED_80M=y
CONFIG_ESP32_SPIRAM_USE_MALLOC=y
CONFIG_ESP32_SPIRAM_MALLOC_ALWAYSINTERNAL=1024

# **La consola per la UART0**, que és el pont USB de la placa, i no pel USB-Serial-JTAG (aquest xip no en té)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
# **Els avisos de la IDF a la consola del sistema i no les seves traces** (0.190.167): the UART this board's console sits on is the same
# one the IDF writes to, o sigui que un `I (39632) gpio: …` per cada configuració d'un pin cau al mig del registre que una persona llegeix.
# El que es queda és el que cal veure: un avís i un error (docs/50, docs/80).
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# **I la IDF sense color**, com el T5S3 des de la 0.190.91 (0.190.172, l'amo: *«Es pot treure l'ANSI?»*): `LOG_COLORS` és l'únic símbol que
# encén els codis d'escapament de les seves línies (`I (13) boot: …`, els avisos del bootloader). El color del **nostre** registre és una
# altra cosa i es tria amb `cfg.ansi` (docs/30, docs/85).
# CONFIG_LOG_COLORS is not set

# El rellotge a 240 MHz, que és el que el governador del sistema mou després per la seva porta
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# **La velocitat la governa el PM del xip** (0.190.175, l'amo: *«la cpu es pot escalar sola a esp_idf... activa la opció i adapta el
# que tenim fet manualment d'scaling»*): `esp_pm` mou el rellotge de la CPU, l'APB i el tick alhora, i els drivers de SPI, I2C, I2S i
# SDMMC agafen el seu lock d'APB durant la transacció, o sigui que el vidre i la targeta no noten el canvi (docs/50, docs/60).
CONFIG_PM_ENABLE=y
# **I el light sleep automàtic no s'encén**: el tickless idle faria becaines entre esdeveniments amb la seva idea de quietud, que és
# exactament el que `kernel::power` ja decideix (el dit, la pàgina al vidre, els deu segons del port i els vint del son més curt).
# **I el DFS no arrenca sol tampoc**: qui el configura és `power::boot` amb el rang que la persona ha permès, i un boot amb l'escala
# apagada ha de poder deixar la placa a un sol pas (docs/50, docs/60).
# CONFIG_PM_DFS_INIT_AUTO is not set
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# El torn del nucli compta mil·lisegons, i la pila del nucli és la dels 16 KB de l'Arduino (docs/75)
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y

# I el C++ sense excepcions ni RTTI, com al build d'Arduino
CONFIG_COMPILER_CXX_EXCEPTIONS=
CONFIG_COMPILER_CXX_RTTI=

# **El TLS allotja a la PSRAM**, i els noms llargs de la targeta encesos (les mateixes dues raons que al `sdkconfig.defaults`)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# **`FATFS_LONG_FILENAMES` no és un booleà**: a la Kconfig és el nom de l'*elecció* —els tres membres són `LFN_NONE`,
# `LFN_HEAP` i `LFN_STACK`—, o sigui que no existeix cap línia `CONFIG_FATFS_LONG_FILENAMES=y` enlloc: la línia de sota
# **és** el seu «sí», amb la memòria del nom a la pila i no al heap (docs/70).
CONFIG_FATFS_LFN_STACK=y

# **Els canaris de la memòria, els mateixos que al build del T5S3** (docs/75, docs/95)
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_COMPILER_STACK_CHECK=y

# La taula de particions és la del projecte, i el LittleFS és el component que porta `src/idf_component.yml`
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# **La WiFi fora de la IRAM** (0.190.166): l'ESP32 té dues memòries i la de les instruccions és la petita; la IDF hi posa les rutines del
# WiFi que ningú crida a cada segon, i aquest build —que és un sistema sencer i no un firmware de xarxa— no hi cap amb elles. El que es
# perd és una mica de temps en un paquet i el que es guanya és el lloc on viure (docs/50, docs/80).
CONFIG_ESP32_WIFI_IRAM_OPT=n
CONFIG_ESP32_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=2

# **El Bluetooth d'aquesta placa** (0.190.201, l'amo: *«i al M5Paper està posat el nimble?»* — i no hi era: aquest fitxer no tenia ni una
# línia `CONFIG_BT` i el codi del ràdio compilava la seva meitat que diu «aquesta placa no en té»). És un **ESP32 de tota la vida**, o
# sigui que el controlador sí que té una meitat Classic a triar i sí que existeix `CONFIG_BTDM_CTRL_MODE_BLE_ONLY` —al revés que a l'S3,
# que només sap fer BLE (docs/50) —. Amb NimBLE i no amb Bluedroid, per la mateixa raó que a l'ATOM: la pila del fabricant són 684 KB de
# flaix i 50-70 KB de heap, i el teclat d'aquest sistema és un HID petit.
#
# **La RAM és el que es mira en aquesta placa i no el flaix** (2 053 488 B de imatge contra una ranura de 4 MB, o sigui que hi cap de
# sobres): el controlador BLE reserva desenes de kilobytes de la interna, i aquesta és la placa amb menys heap lliure del projecte.
# O sigui que el que s'ha de mesurar després de gravar-lo és `heap` al prompt amb el ràdio apagat i amb `bt dev on`.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# **Els vincles s'han de desar** (0.190.197): sense això la botiga del ràdio viu a la RAM —i no dona cap error—, o sigui que el teclat
# d'un mòbil s'ha de tornar a aparellar a cada reinici i `bt host reconnect` no pot trobar mai res (docs/50, docs/70).
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# **El node de Bluetooth Mesh** (0.190.212, l'amo: *«pots posar algun mesh?»*): la pila d'Espressif damunt de la mateixa NimBLE que el
# teclat, amb un element i el servidor de configuració, i res més. **Node i no provisionador**: el que ha de poder fer aquesta placa és
# deixar-se afegir a una xarxa des del telèfon (nRF Mesh o l'app d'Espressif), i un provisionador és una altra pila i una altra feina.
# La memòria de la pila és la interna (l'estratègia de sèrie), perquè el mesh toca cues i temporitzadors de debò; si algun dia no hi cap,
# `CONFIG_BLE_MESH_MEM_ALLOC_MODE_EXTERNAL` és la porta, i demana `SPIRAM_USE_MALLOC` (docs/50, docs/75).
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PB_ADV=y
CONFIG_BLE_MESH_PB_GATT=y
CONFIG_BLE_MESH_GATT_PROXY_SERVER=y
# **El node recorda la xarxa** on l'han posat: sense això, cada arrencada torna a ser un node verge i el provisionador l'ha de tornar a
# afegir. Els seus bytes van a la NVS que el sistema ja té (no demana una partició pròpia).
CONFIG_BLE_MESH_SETTINGS=y
# **I l'anunci normal al costat del mesh**: és el que fa possible que el teclat i el node convisquin quan el mesh hi és; sense això el
# mesh es queda l'anunciador per a ell tot sol (docs/50).
CONFIG_BLE_MESH_SUPPORT_BLE_ADV=y

# **El xip d'aquesta placa és un rev 3, i amb això cauen vint-i-un kilobytes de la IRAM** (0.190.201). El projecte declarava la
# revisió mínima **0**, i la IDF té una opció que en depèn: `CONFIG_SPIRAM_CACHE_WORKAROUND` —l'arranjament del forat de la memòria
# cau del rev 1—, que a més a més demana que **mitja libc** (les matemàtiques, les cadenes, el `printf`, el `malloc`…) visqui a la
# IRAM. Amb el Bluetooth a dins, l'enllaçador va dir `region iram0_0_seg overflowed by 21296 bytes`, i aquests vint-i-un kilobytes
# eren exactament això.
#
# **El xip està serigrafiat `ESP32-D0WDQ6-V3`** —el mateix que diu docs/50 de la placa—, o sigui que la revisió mínima és la 3 i el
# que la documentació de la IDF diu d'aquest arranjament és literalment «not required for ESP32 revision 3 and above». El preu és
# que aquest firmware no arrenca en una Paper amb un xip rev 1 o 2, que no existeix: la placa és del 2021 i el rev 3 és del 2019.
CONFIG_ESP32_REV_MIN_3=y

# **L'optimització de la IDF, que aquí no és una preferència sinó el que fa que el ràdio hi càpiga** (0.190.201). El projecte compila
# els seus components amb `-Og` (`CONFIG_COMPILER_OPTIMIZATION_DEBUG`, el defecte d'un build de desenvolupament) i el que queda a la
# IRAM —les taules de vectors, el port de FreeRTOS, `esp_hw_support`, el `ringbuf` del driver d'SPI— és codi de la IDF: amb el
# Bluetooth a dins, l'enllaçador encara es passava 2 940 B. `-Os` no toca ni una línia del nostre codi (els `lib/` els compila
# PlatformIO amb les seves banderes) i la feina que es fa més lenta és la de la mateixa IDF: capçaleres i rutines de sistema, no el
# bucle d'una app ni l'intèrpret.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
